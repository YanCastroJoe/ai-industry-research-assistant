# Optional OpenAI-compatible model configuration. Leave MODEL_API_KEY empty to use local rules.
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_API_KEY=
MODEL_NAME=deepseek-chat

# Single-process background queue limits.
DOCFLOW_MAX_WORKERS=2
DOCFLOW_MAX_PENDING=20

# Restricted interview-demo settings. Keep the real password only in .env.
DOCFLOW_DEMO_MODE=false
DOCFLOW_DEMO_USERNAME=
DOCFLOW_DEMO_PASSWORD=
DOCFLOW_RATE_LIMIT_PER_MINUTE=60
DOCFLOW_BIND_ADDRESS=127.0.0.1
DOCFLOW_PORT=8010
